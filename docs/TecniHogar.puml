class Cuadrilla {
  - codigo: String {readOnly}
  - capacidad: double {readOnly}
  - refrigeracion: boolean {readOnly}
  + Cuadrilla(codigo: String, capacidad: double, refrigeracion: boolean)
  + getCodigo(): String
  + getCapacidad(): double
  + isRefrigeracion(): boolean
  + toString(): String {override}
}
class Diagnostico {
  + Diagnostico(codigo: String, cliente: String, direccion: String, horas: double, zona: Zona)
  + calcularCosto(): BigDecimal {override}
  + diasAtencion(): int {override}
  + maxVisitas(): int {override}
  + categoria(): String {override}
}
OrdenServicio <|-- Diagnostico
enum EstadoJornada {
  PREPARACION
  EN_CURSO
  CERRADA
}
enum EstadoOrden {
  PENDIENTE
  ASIGNADA
  EN_ATENCION
  COMPLETADA
  CANCELADA
}
class Instalacion {
