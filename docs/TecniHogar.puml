  + capacidadDisponible(): BigDecimal
  ~ asignar(orden: OrdenServicio): void
  ~ retirar(orden: OrdenServicio): void
  ~ iniciar(): Map<String, BigDecimal>
  ~ registrarResultado(orden: OrdenServicio, completada: boolean): void
  + toString(): String {override}
}
class Main {
  - entrada: Scanner {readOnly}
  - sistema: Sistema {readOnly}
  + Main()
  + main(args: String[]): void {static}
  + ejecutar(): void
  - texto(mensaje: String): String
